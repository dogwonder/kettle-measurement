{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kettle",
  "version": "0.1.0",
  "identifier": "app.kttl.kettle",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kettle",
        "width": 1160,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self' asset:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/runs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "resources": {
      "../../packs/": "packs/",
      "models.json": "models.json"
    }
  }
}
